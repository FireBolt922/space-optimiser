# Planning documents stay on this machine. They are not part of the
# application and are not committed by a normal git add.
# This does not untrack files that are already committed.
/develop-eggs/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# Rust
target/
**/*.rs.bk
# Commit Cargo.lock. This is an application, not a library.

